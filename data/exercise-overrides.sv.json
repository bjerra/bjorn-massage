  "Side_Bridge": {
    "cue_sv": [
      "Ligg på sidan med underarmen mot golvet och armbågen rakt under axeln. Stapla fötterna, eller ställ den övre foten framför den undre.",
      "Lyft höften så att kroppen bildar en rak linje från huvudet till fötterna. Spänn bålen.",
      "Håll positionen utan att låta höften sjunka. Andas lugnt.",
      "Sänk höften kontrollerat och byt sida."
    ]
  },
  "Side_Jackknife": {
    "name_sv": "Sidliggande fällkniv",
    "cue_sv": [
      "Ligg på sidan med raka ben. Den undre armen kan vila längs golvet, och den övre handen lätt mot huvudet.",
      "Lyft samtidigt det övre benet och överkroppen mot varandra, som en fällkniv på sidan. Känn arbetet i sidans bål.",
      "Sänk kontrollerat tillbaka till startläget.",
      "Upprepa och byt sedan sida."
    ]
  },
