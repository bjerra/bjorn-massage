---
import Layout from '../layouts/Layout.astro';
import '../styles/rom.css';
import '../styles/muscle-modal.css';

const description =
    'ROM – rörelser och muskler. Välj en led och se muskler som vanligtvis arbetar. Listan är ingen undersökning.';
---

<Layout title="ROM – rörelser och muskler" description={description}>
    <link slot="head" rel="stylesheet" href="/bodymap/bodymap.css" />
    <link slot="head" rel="stylesheet" href="/bodymap/site-theme.css" />

    <header class="map-page-head">
        <h1>ROM</h1>
        <a href="/muskelkarta">Triggerpunkter på muskelkartan</a>
    </header>
    <p class="rom-lede">Rörelser och muskler. Välj en led, sedan en rörelse.</p>

    <div class="rom" data-rom>
        <form id="rom-form" class="rom-search" role="search">
            <label for="rom-q">Sök</label>
            <input
                id="rom-q"
                type="search"
                autocomplete="off"
                enterkeyhint="search"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="rom-suggest"
                aria-expanded="false"
                placeholder="Till exempel lyfta armen eller böja knät"
            />
            <ul id="rom-suggest" class="rom-suggest" role="listbox" hidden></ul>
        </form>
        <p id="rom-status" class="rom-status" aria-live="polite"></p>

        <div class="rom-stage">
            <div class="rom-figure">
                <div class="rom-side">
                    <div class="rom-key-row" data-rom-key-row hidden>
                        <p class="rom-key rom-key-phone" data-rom-key></p>
                        <div data-rom-flip></div>
                    </div>
                    <div
                        data-bodymap
                        data-mode="movements"
                        data-chrome="rom"
                        data-keep-movement
                        data-single-view
                    >
                    </div>
                    <div class="rom-phone-muscles" data-rom-phone-muscles hidden></div>
                </div>
                <div class="rom-rail" data-rom-rail></div>
            </div>
            <div class="rom-detail" data-rom-detail></div>
        </div>
    </div>

    <script is:inline>
        window.BODYMAP_MOVEMENT_MODE = true;
    </script>
    <script is:inline src="/bodymap/strings-sv.js"></script>
    <script is:inline src="/bodymap/bodymap-data.js" defer></script>
    <script is:inline src="/bodymap/bodymap-zones.js" defer></script>
    <script is:inline src="/bodymap/bodymap.js" defer></script>
    <script>
        import { startRom } from '../scripts/rom-page';
        startRom();
    </script>
</Layout>
