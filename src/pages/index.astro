---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { placeUrl } from '../data/site';
// Hero portrait. Replace this one file to use a photo of Björn.
import hero from '../assets/hero.jpg';
import neoLogo from '../assets/neo.png';
import ServiceList from '../components/ServiceList.astro';

const title = 'BjörnMassage – Massage i Jönköping';
const description =
    'Björn Eriksson ger klassisk massage och triggerpunktsbehandling på Neoskin i Jönköping. Boka tid via Bokadirekt.';

const mapsUrl = 'https://www.google.com/maps/place/Lantm%C3%A4targr%C3%A4nd+16,+553+20+J%C3%B6nk%C3%B6ping/@57.7815,14.1734,17z';
const mapEmbed = 'https://maps.google.com/maps?q=57.7815,14.1734&hl=sv&z=16&output=embed';

// Neoskin's published opening hours, from Bokadirekt place 39252.
const hours = [
    ['Måndag', '08:30–17:00'],
    ['Tisdag', '08:30–17:00'],
    ['Onsdag', '08:30–18:00'],
    ['Torsdag', '08:30–19:00'],
    ['Fredag', '08:30–18:00'],
    ['Lördag', '09:00–16:00'],
    ['Söndag', '11:00–16:00']
];

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': ['HealthAndBeautyBusiness', 'LocalBusiness'],
    name: 'BjörnMassage',
    description,
    url: 'https://bjornmassage.se/',
    image: 'https://bjornmassage.se/og.jpg',
    address: {
        '@type': 'PostalAddress',
        streetAddress: 'Lantmätargränd 16',
        postalCode: '553 20',
        addressLocality: 'Jönköping',
        addressCountry: 'SE'
    },
    geo: {
        '@type': 'GeoCoordinates',
        latitude: 57.7815,
        longitude: 14.1734
    },
    employee: {
        '@type': 'Person',
        name: 'Björn Eriksson',
        jobTitle: 'Massageterapeut'
    },
    openingHoursSpecification: [
        { dayOfWeek: 'Monday', opens: '08:30', closes: '17:00' },
        { dayOfWeek: 'Tuesday', opens: '08:30', closes: '17:00' },
        { dayOfWeek: 'Wednesday', opens: '08:30', closes: '18:00' },
        { dayOfWeek: 'Thursday', opens: '08:30', closes: '19:00' },
        { dayOfWeek: 'Friday', opens: '08:30', closes: '18:00' },
        { dayOfWeek: 'Saturday', opens: '09:00', closes: '16:00' },
        { dayOfWeek: 'Sunday', opens: '11:00', closes: '16:00' }
    ].map((day) => ({ '@type': 'OpeningHoursSpecification', ...day })),
    sameAs: [placeUrl, 'https://neoskin.se/']
};
---

<Layout title={title} description={description}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <section class="hero">
        <h1 class="display">Massage med <em>lugn</em> hand och fast tryck.</h1>
        <div>
            <Image
                src={hero}
                alt="Massage av nacke och axlar"
                width={800}
                height={1192}
                format="webp"
                class="hero-photo"
                loading="eager"
            />
            <p class="hero-copy">
                Björn Eriksson är certifierad massageterapeut med 15 års erfarenhet. Behandlingen anpassas efter hur det
                känns för dig.
            </p>
            <a class="btn" href={placeUrl}>Boka tid på Bokadirekt</a>
        </div>
    </section>
    <section id="tjanster" class="services">
        <h2>Behandlingar</h2>
        <ServiceList />
    </section>
    <section id="om-mig" class="section">
        <h2>Om mig</h2>
        <div class="prose">
            <p>
                Jag arbetar med klassisk massage och triggerpunktsbehandling, med fokus på ställen som känns spända eller
                ömma. Hur det upplevs varierar från person till person.
            </p>
            <p>Jag jobbar lugnt men tungt, som en björn fast utan klor.</p>
            <p>Välkommen att boka tid.</p>
        </div>
    </section>
    <section id="kontakt" class="section">
        <h2>Kontakt</h2>
        <p class="lede">Jag tar emot på Neoskin. Tid bokas hos mig via Bokadirekt.</p>
        <a class="btn" href={placeUrl}>Boka tid</a>
        <div class="contact-grid">
            <div>
                <a class="neo-link" href="https://neoskin.se/">
                    <Image src={neoLogo} alt="Neoskin" width={150} height={62} class="neo-mark" />
                </a>
                <p>
                    Lantmätargränd 16<br />
                    553 20 Jönköping
                </p>
                <h3>Öppettider på Neoskin</h3>
                <ul class="hours">
                    {
                        hours.map(([day, time]) => (
                            <li>
                                <span>{day}</span>
                                <span>{time}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <iframe
                    title="Karta till Neoskin, Lantmätargränd 16 i Jönköping"
                    src={mapEmbed}
                    class="map-frame"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                />
                <p class="map-link">
                    <a href={mapsUrl}>Öppna adressen i Google Maps</a>
                </p>
            </div>
        </div>
    </section>
</Layout>
