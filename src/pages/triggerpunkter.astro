---
import Layout from '../layouts/Layout.astro';
import { placeUrl } from '../data/site';
import '../styles/exercises.css';

const description =
    'Interaktiv karta över triggerpunkter hos BjörnMassage i Jönköping, med stretch- och styrkeövningar att slå upp. Typiska utstrålningsmönster från litteraturen. Smärta kan ha andra orsaker.';
---

<Layout title="Triggerpunkter – BjörnMassage" description={description}>
    <link slot="head" rel="stylesheet" href="/bodymap/bodymap.css" />
    <link slot="head" rel="stylesheet" href="/bodymap/site-theme.css" />

    <section class="section trigger-intro" lang="sv">
        <h1>Triggerpunkter</h1>
        <div class="prose">
            <p>
                En triggerpunkt är ett ömt ställe i en muskel. Det kan göra ont just där, och ibland känns smärtan också
                någon annanstans. Kartan visar typiska utstrålningsmönster från triggerpunktslitteraturen (Travell &amp;
                Simons).
            </p>
            <p>
                Smärta kan ha många andra orsaker. Kartan är ingen undersökning och säger inte vad just din smärta beror
                på. Vid svår, ihållande eller oförklarad smärta, kontakta vården.
            </p>
            <p>
                Tryck på området där det gör ont, eller välj en muskel. Områdena är på svenska. Musklerna visas med
                latinskt namn. Den korta texten om var på muskeln punkten sitter är på engelska. Till en vald muskel
                visas också stretch- och styrkeövningar. De är allmänna förslag, inte en behandlingsplan.
            </p>
        </div>
        <p class="mt-8">
            <a class="btn" href={placeUrl}>Boka tid</a>
        </p>
    </section>

    <section class="ex-search" aria-labelledby="ex-search-title">
        <h2 id="ex-search-title">Sök övning</h2>
        <p class="lede">
            Övningarna är allmänna förslag, inte en behandlingsplan. Avbryt om något gör ont, och fråga Björn vid
            besöket.
        </p>
        <form id="ex-search-form" class="ex-form" role="search">
            <div class="ex-field">
                <label for="ex-q">Namn</label>
                <input
                    id="ex-q"
                    type="search"
                    name="q"
                    autocomplete="off"
                    enterkeyhint="search"
                    placeholder="Till exempel trapezius, kappmuskel eller hamstring"
                />
            </div>
            <div class="ex-filters">
                <div id="ex-search-types" class="ex-chips" role="group" aria-label="Typ av övning">
                    <button type="button" class="ex-chip" data-value="all" aria-pressed="true">Alla</button>
                    <button type="button" class="ex-chip" data-value="stretching" aria-pressed="false">Stretch</button>
                    <button type="button" class="ex-chip" data-value="strengthen" aria-pressed="false">Styrka</button>
                </div>
                <label class="ex-level">
                    Nivå
                    <select id="ex-search-level">
                        <option value="all">Alla</option>
                        <option value="beginner">Nybörjare</option>
                        <option value="intermediate">Medel</option>
                        <option value="expert">Avancerad</option>
                    </select>
                </label>
            </div>
        </form>
        <p id="ex-search-status" class="ex-status" aria-live="polite"></p>
        <ul id="ex-search-list" class="ex-list"></ul>
        <button type="button" id="ex-search-more" class="ex-more" hidden>Visa fler</button>
    </section>

