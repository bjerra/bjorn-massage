---
import Layout from '../layouts/Layout.astro';
import '../styles/exercises.css';
import '../styles/muscle-modal.css';

const description =
    'Stretch- och styrkeövningar att slå upp efter muskel. Latinska muskelnamn. Allmänna förslag, inte en behandlingsplan.';
---

<Layout title="Övningar – BjörnMassage" description={description}>
    <link slot="head" rel="stylesheet" href="/bodymap/bodymap.css" />
    <link slot="head" rel="stylesheet" href="/bodymap/site-theme.css" />

    <header class="map-page-head">
        <h1>Övningar</h1>
    </header>
    <p class="ex-lead">Välj en muskel på kartan, eller sök på övningens namn.</p>

    <section class="ex-search" aria-label="Sök övning">
        <form id="ex-search-form" class="ex-form" role="search">
            <div class="ex-field">
                <label for="ex-q">Namn</label>
                <input
                    id="ex-q"
                    type="search"
                    name="q"
                    autocomplete="off"
                    enterkeyhint="search"
                    placeholder="Till exempel trapezius eller hamstring"
                />
            </div>
            <div class="ex-filters">
                <div id="ex-search-types" class="ex-chips" role="group" aria-label="Typ av övning">
                    <button type="button" class="ex-chip" data-value="all" aria-pressed="true">Alla</button>
                    <button type="button" class="ex-chip" data-value="stretching" aria-pressed="false">Stretch</button>
                    <button type="button" class="ex-chip" data-value="strengthen" aria-pressed="false">Styrka</button>
                </div>
                <label class="ex-level">
                    Nivå
                    <select id="ex-search-level">
                        <option value="all">Alla</option>
                        <option value="beginner">Nybörjare</option>
                        <option value="intermediate">Medel</option>
                        <option value="expert">Avancerad</option>
                    </select>
                </label>
            </div>
        </form>
        <p id="ex-search-status" class="ex-status" aria-live="polite"></p>
        <ul id="ex-search-list" class="ex-list"></ul>
        <button type="button" id="ex-search-more" class="ex-more" hidden>Visa fler</button>
    </section>

    <div class="trigger-map ex-tool">
        <div data-bodymap data-mode="muscles"></div>
    </div>

    <script is:inline>
        (function () {
            var params = new URLSearchParams(location.search);
            var muscle = params.get('muskel');
            var zone = params.get('zon');
            var ovning = params.get('ovning');
            if (!muscle && !zone && !ovning) return;
            if (/(?:^#|&)(?:muscle|zone|ex)=/.test(location.hash)) return;
            var bits = [];
            if (zone) bits.push('zone=' + encodeURIComponent(zone));
            if (muscle) bits.push('muscle=' + encodeURIComponent(muscle));
            if (ovning) bits.push('ex=' + encodeURIComponent(ovning));
            var hash = '#' + bits.join('&');
            history.replaceState(null, '', location.pathname + location.search + hash);
        })();
        window.EXERCISE_PAGE = true;
    </script>
    <script is:inline src="/bodymap/strings-sv.js"></script>
    <script is:inline>
        window.BODYMAP_STRINGS.hintMuscles = '';
        window.BODYMAP_STRINGS.emptyMusclesTitle = 'Välj en muskel';
        window.BODYMAP_STRINGS.emptyMusclesText = '';
    </script>
    <script is:inline src="/bodymap/bodymap-data.js" defer></script>
    <script is:inline src="/bodymap/bodymap-zones.js" defer></script>
    <script is:inline src="/bodymap/bodymap.js" defer></script>

    <script>
        import '../scripts/trigger-exercises.js';
    </script>
</Layout>
