---
import Layout from '../layouts/Layout.astro';
import '../styles/exercises.css';

const description =
    'Muskelkarta med triggerpunkter. Områden och latinska muskelnamn. Kartan är ingen undersökning.';
---

<Layout title="Muskelkarta – BjörnMassage" description={description}>
    <link slot="head" rel="stylesheet" href="/bodymap/bodymap.css" />
    <link slot="head" rel="stylesheet" href="/bodymap/site-theme.css" />

    <header class="map-page-head">
        <h1>Muskelkarta</h1>
        <a href="/rom">ROM – rörelser och muskler</a>
    </header>

    <div class="trigger-map">
        <div data-bodymap></div>
    </div>
    <script is:inline>
        (function () {
            var params = new URLSearchParams(location.search);
            var hash = location.hash || '';
            if (params.get('lage') === 'rorelser' || hash === '#rorelser') {
                location.replace('/rom');
                return;
            }
            if (/^#movement=[A-Za-z]+\.[A-Za-z]+/.test(hash)) location.replace('/rom' + hash);
        })();
    </script>
    <script is:inline src="/bodymap/strings-sv.js"></script>
    <script is:inline src="/bodymap/bodymap-data.js" defer></script>
    <script is:inline src="/bodymap/bodymap-zones.js" defer></script>
    <script is:inline src="/bodymap/bodymap.js" defer></script>
    <script>
        import '../scripts/muscle-exercise-link.js';
    </script>
</Layout>
