---
import servicesData from '../data/services.json';

const services = servicesData.services;

function priceText(service: (typeof services)[number], label = service.priceLabel) {
    if (service.hidePrice) return '';
    const value = label || (service.price != null ? `${service.price} kr` : '');
    if (!value) return '';
    return service.showFrom ? `Från ${value}` : value;
}

function durationText(service: (typeof services)[number]) {
    if (service.hideDuration) return '';
    return service.durationLabel || '';
}

function displaySummary(summary: string) {
    const text = summary
        .replaceAll('Är dörren låt?', 'Är dörren låst?')
        .replace(/Glöm inte bort att använda ditt friskvårdsbidrag hos oss[!.]?/gi, '')
        .replace(/\s+/g, ' ')
        .trim();
    return text || summary;
}
---

<div>
    <ol class="service-list">
        {
            services.map((service, index) => {
                const price = priceText(service);
                const duration = durationText(service);
                const campaign = service.campaign;
                const campaignPrice = campaign ? priceText(service, campaign.priceLabel) : '';
                const summary = service.summary ? displaySummary(service.summary) : '';
                return (
                    <li class="service-row">
                        <div class="service-num">{String(index + 1).padStart(2, '0')}</div>
                        <div>
                            <h3>{service.name}</h3>
                            {summary && <p class="summary">{summary}</p>}
                        </div>
                        <div class="service-meta">
                            <div class="service-dur">{duration}</div>
                            <div
                                class="service-price"
                                data-campaign={campaign ? 'active' : undefined}
                                data-start={campaign?.startDate}
                                data-end={campaign?.endDate}
                            >
                                {campaign && campaignPrice ? (
                                    <>
                                        <p data-sale-view>
                                            {price && (
                                                <s>
                                                    <span class="sr-only">Ordinarie pris </span>
                                                    {price}
                                                </s>
                                            )}
                                            <b>
                                                <span class="sr-only">Kampanjpris </span>
                                                {campaignPrice}
                                            </b>
                                        </p>
                                        {price && (
                                            <p data-regular-view hidden>
                                                <b>{price}</b>
                                            </p>
                                        )}
                                        <p class="service-tag" data-sale-badge>
                                            Kampanj {campaign.endLabel}
                                        </p>
                                    </>
                                ) : (
                                    price && <b>{price}</b>
                                )}
                            </div>
                            <a class="book-link" href={service.bookingUrl}>
                                Boka <span aria-hidden="true">↗</span>
                                <span class="sr-only"> {service.name}</span>
                            </a>
                        </div>
                    </li>
                );
            })
        }
    </ol>
    <p class="friskvard">Friskvårdsbidrag kan användas.</p>
    <script is:inline>
        (function () {
            var now = Date.now() / 1000;
            var nodes = document.querySelectorAll('[data-campaign]');
            for (var i = 0; i < nodes.length; i++) {
                var el = nodes[i];
                var start = Number(el.getAttribute('data-start'));
                var end = Number(el.getAttribute('data-end'));
                var active = now >= start && now < end;
                var sale = el.querySelector('[data-sale-view]');
                var regular = el.querySelector('[data-regular-view]');
                var badge = el.querySelector('[data-sale-badge]');
                if (sale) sale.hidden = !active;
                if (regular) regular.hidden = active;
                if (badge) badge.hidden = !active;
            }
        })();
    </script>
</div>
