---
import { Image } from 'astro:assets';
import { placeUrl } from '../data/site';
import ymfLogo from '../assets/yrkesmassorernas-forbund.png';

const year = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
    { text: 'Behandlingar', href: '/#tjanster' },
    { text: 'Skrivbordsprogrammet', href: '/skrivbordsprogrammet' },
    { text: 'Muskelkarta', href: '/muskelkarta' },
    { text: 'ROM', href: '/rom' },
    { text: 'Övningar', href: '/ovningar' },
    { text: 'Om mig', href: '/#om-mig' },
    { text: 'Kontakt', href: '/#kontakt' },
    { text: 'Boka tid', href: placeUrl }
];
---

<footer class="site-footer">
    <div class="footer-grid">
        <div>
            <p class="footer-kicker">Besök</p>
            <p class="footer-address">
                Neoskin<br />
                Lantmätargränd 16<br />
                553 20 Jönköping
            </p>
            <p class="footer-hours">
                <a href="/#oppettider">Öppettider</a>
            </p>
        </div>
        <nav class="footer-nav" aria-label="Sidfot">
            <ul>
                {
                    links.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                aria-current={!item.href.includes('#') && !item.href.startsWith('http') && item.href === pathname ? 'page' : undefined}
                            >
                                {item.text}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
    <a class="footer-member ymf-link" href="https://yrkesmassorerna.se/" target="_blank" rel="noopener">
        <span class="footer-member-label">Medlem i</span>
        <Image
            src={ymfLogo}
            alt="Yrkesmassörernas Förbund"
            width={850}
            height={193}
            format="webp"
            quality={90}
            class="ymf-mark ymf-mark-footer"
        />
    </a>
    <p class="footer-copy">© {year} Björn Massage</p>
</footer>
